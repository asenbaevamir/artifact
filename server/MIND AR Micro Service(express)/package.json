{
  "name": "mind-ar-microservice",
  "version": "3.0.0",
  "description": "Async parallel AR target (.mind) compilation API for backend-to-backend use",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "start:all": "node dist/server.js & node dist/worker.js"
  },
  "keywords": [
    "mind-ar",
    "ar",
    "image-compiler",
    "microservice"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@msgpack/msgpack": "^2.8.0",
    "@tensorflow/tfjs": "^4.17.0",
    "bullmq": "^5.76.8",
    "canvas": "^2.11.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "mathjs": "^11.6.0",
    "mind-ar": "^1.2.5",
    "ml-matrix": "^6.10.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.3",
    "svd-js": "^1.1.1",
    "tinyqueue": "^2.0.3",
    "uuid": "^9.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5"
  }
}
