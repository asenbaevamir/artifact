# ─── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ─── Redis (required for async queue) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Worker ─────────────────────────────────────────────────────────────────────
# How many .mind files compile in parallel per worker instance
WORKER_CONCURRENCY=3

# ─── Directories ────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
RESULTS_DIR=results

# ─── Rate limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
